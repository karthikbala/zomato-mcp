limit_req_zone $binary_remote_addr zone=zomato_mcp:1m rate=60r/m;
server {
    listen 80;
    server_name zomato.example.com;
    location /.well-known/acme-challenge/ { root /var/www/zomato-acme; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl http2;
    server_name zomato.example.com;
    ssl_certificate /etc/letsencrypt/live/zomato.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/zomato.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 8k;
    server_tokens off;
    access_log off;
    location / {
        limit_req zone=zomato_mcp burst=30 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:9320;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 180s;
    }
}
