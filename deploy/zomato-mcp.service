[Unit]
Description=Zomato Restaurant Partner MCP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zomato-mcp
Group=zomato-mcp
WorkingDirectory=/opt/zomato-mcp
EnvironmentFile=/etc/zomato-mcp/service.env
Environment=BROWSER_HEADLESS=false
ExecStart=/usr/bin/xvfb-run -a /opt/zomato-mcp/runtime/bin/node src/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/zomato-mcp
UMask=0077
MemoryMax=2G
TasksMax=512

[Install]
WantedBy=multi-user.target
