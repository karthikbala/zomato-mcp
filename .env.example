PORT=9320
DATA_DIR=/var/lib/zomato-mcp
PUBLIC_ORIGIN=https://zomato.example.com
ZOMATO_MOBILE=9000000000
ZOMATO_RESTAURANT_ID=12345678
ZOMATO_OUTLET_NAME=Example Cafe
MCP_TOKEN=replace-with-a-random-32-byte-or-longer-secret
OWNER_KEY=replace-with-a-different-random-32-byte-or-longer-secret
PLAYWRIGHT_BROWSERS_PATH=/var/lib/zomato-mcp/browsers
BROWSER_HEADLESS=false
